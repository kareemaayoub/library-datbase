<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Books</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="card wide">
        <%- include('nav', { title: 'Books' }) %>

        <form class="lib-form" action="/books" method="POST" enctype="multipart/form-data">
            <input type="text" name="title" placeholder="Title" value="<%= old.title || '' %>">
            <input type="text" name="price" placeholder="Price" value="<%= old.price || '' %>">
            <input type="text" name="publish_year" placeholder="Year" value="<%= old.publish_year || '' %>">
            <select name="author_id">
                <option value="">Choose an author</option>
                <% authors.forEach(a => { %>
                    <option value="<%= a.author_id %>" <%= String(old.author_id) === String(a.author_id) ? 'selected' : '' %>>
                        <%= a.name %> (<%= a.author_id %>)
                    </option>
                <% }) %>
            </select>
            <select name="publisher_id">
                <option value="">Choose a publisher</option>
                <% publishers.forEach(x => { %>
                    <option value="<%= x.publisher_id %>" <%= String(old.publisher_id) === String(x.publisher_id) ? 'selected' : '' %>><%= x.name %></option>
                <% }) %>
            </select>
            <select name="category_id">
                <option value="">Choose a category</option>
                <% categories.forEach(x => { %>
                    <option value="<%= x.category_id %>" <%= String(old.category_id) === String(x.category_id) ? 'selected' : '' %>><%= x.name %></option>
                <% }) %>
            </select>
            <input type="file" name="cover" accept="image/*">
            <button type="submit" class="btn">Add book</button>
        </form>
        <span class="field-error"><%= errors.add || '' %></span>

        <% if (books.length === 0) { %>
            <p class="empty">No books yet. Add the first one above.</p>
        <% } else { %>
            <div class="table-wrap">
                <table class="data">
                    <tr><th>ID</th><th>Cover</th><th>Title</th><th>Price</th><th>Year</th><th>Author ID</th><th></th></tr>
                    <% books.forEach(b => { %>
                        <tr>
                            <td><%= b.book_id %></td>
                            <td><% if (b.cover) { %><img class="thumb" src="/uploads/<%= b.cover %>" alt="cover"><% } %></td>
                            <td><%= b.title %></td>
                            <td><%= b.price %></td>
                            <td><%= b.publish_year %></td>
                            <td><%= b.author_id %></td>
                            <td>
                                <div class="actions">
                                <a class="btn-outline" href="/books/<%= b.book_id %>/edit">Edit</a>
                                <form action="/books/<%= b.book_id %>/delete" method="POST"
                                      onsubmit="return confirm('Are you sure you want to delete this book?')">
                                    <button type="submit" class="btn-danger">Delete</button>
                                </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </table>
            </div>
        <% } %>
    </div>
</body>
</html>
